{
  "name": "trivia-map",
  "version": "3.0.0",
  "private": true,
  "workspaces": ["apps/*", "packages/*", "infra"],
  "engines": { "node": "24.21.0", "npm": ">=11" },
  "scripts": {
    "build": "npm run build --workspace=@triviamap/front && npm run build --workspace=@triviamap/api && npm run build --workspace=@triviamap/infra",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:ci": "npm run test:ci --workspaces --if-present",
    "synth": "npm run synth --workspace=@triviamap/infra"
  }
}
